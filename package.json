{
  "name": "viewit",
  "version": "0.1.0-scaffold",
  "private": true,
  "type": "module",
  "description": "Universal file viewer — Tauri v2 + Svelte 5 monorepo root",
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:desktop": "npm run tauri dev --workspace apps/desktop",
    "dev:android": "npm run tauri android dev --workspace apps/mobile",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "build:desktop": "npm run tauri build --workspace apps/desktop",
    "build:android": "npm run tauri android build --workspace apps/mobile",
    "build:android-release": "./scripts/android-release.sh",
    "build:web": "npm run build --workspace apps/web",
    "lint": "prettier --check 'apps/**/*.{ts,svelte,js}' 'packages/**/*.{ts,svelte,js}'",
    "format": "prettier --write 'apps/**/*.{ts,svelte,js}' 'packages/**/*.{ts,svelte,js}'",
    "check": "tsc --noEmit -p packages/platform",
    "test:ts": "vitest run -c packages/platform/vitest.config.ts",
    "test:rust": "cargo test --workspace --exclude viewit-mobile --exclude viewit-desktop --lib",
    "test:e2e": "playwright test --config e2e/web/playwright.config.ts",
    "test": "npm run test:rust && npm run test:ts",
    "size-check": "node scripts/size-budget.ts"
  },
  "devDependencies": {
    "@playwright/browser-chromium": "^1.50.0",
    "@playwright/test": "^1.50.0",
    "@tauri-apps/cli": "^2.11.4",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.6",
    "tsx": "^4.23.0",
    "turbo": "^2.10.8",
    "typescript": "^5.6.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-svelte"
    ],
    "overrides": [
      {
        "files": "*.svelte",
        "options": {
          "parser": "svelte"
        }
      }
    ],
    "printWidth": 100
  },
  "dependencies": {
    "@silurus/ooxml": "^0.72.2"
  }
}
