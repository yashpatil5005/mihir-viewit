{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viewit.ai/schemas/plugin-package-manifest.v1.schema.json",
  "title": "ViewIt Plugin Package Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "minAppVersion", "runtime", "providers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "description": { "type": "string" },
    "publisher": { "type": "string", "minLength": 1 },
    "minAppVersion": { "type": "integer", "minimum": 1 },
    "runtime": { "enum": ["android-dex", "android-dex-jni", "webview-js", "wasm", "external-worker"] },
    "entryClass": { "type": "string" },
    "jsEntry": { "type": "string" },
    "cssEntry": { "type": "string" },
    "abi": { "type": "string" },
    "abiVersion": { "type": "integer", "minimum": 1 },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "provider-descriptor.v1.schema.json" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "runtime": { "const": "webview-js" } } },
      "then": { "required": ["jsEntry"] },
      "else": { "required": ["entryClass"] }
    }
  ]
}
