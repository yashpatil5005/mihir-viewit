{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viewit.ai/schemas/legacy-plugin-entry.schema.json",
  "title": "Legacy ViewIt Plugin Entry",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "version", "minAppVersion", "entryClass", "supportedFormats", "runtime", "abiVersion", "downloadUrl", "sizeBytes", "installedSizeBytes", "checksum"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "minAppVersion": { "type": "integer", "minimum": 1 },
    "entryClass": { "type": "string" },
    "supportedFormats": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "base": { "enum": ["view", "play", "edit", "tool"] },
    "runtime": { "type": "string", "minLength": 1 },
    "abi": { "type": "string" },
    "abiVersion": { "type": "integer", "minimum": 1 },
    "downloadUrl": { "type": "string", "minLength": 1 },
    "sizeBytes": { "type": "integer", "minimum": 1 },
    "installedSizeBytes": { "type": "integer", "minimum": 1 },
    "checksum": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "jsEntry": { "type": "string" },
    "cssEntry": { "type": "string" }
  }
}
