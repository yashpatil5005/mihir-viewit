{
  "schemaVersion": 1,
  "id": "editor-base",
  "name": "Editor Base",
  "version": "0.1.0",
  "description": "Inline text/markdown editor (base=edit). Editing and save are the plugin's responsibility (round-trip the file).",
  "publisher": "viewit",
  "minAppVersion": 1,
  "runtime": "webview-js",
  "jsEntry": "index.js",
  "abiVersion": 1,
  "providers": [
    {
      "id": "editor-base.edit",
      "packageId": "editor-base",
      "service": "viewit.document.edit",
      "contractVersion": 1,
      "runtime": "webview-js",
      "trustClass": "trusted-in-process",
      "formats": [
        "md",
        "markdown",
        "mdown",
        "txt",
        "text",
        "json",
        "yaml",
        "yml",
        "srt"
      ],
      "hostGrants": [
        "viewit.host.save-as"
      ]
    }
  ]
}
