{
  "schemaVersion": 1,
  "id": "player-base",
  "name": "Player Base",
  "version": "0.1.0",
  "description": "Custom media player (base=play). Swaps the built-in web player with a custom UI/engine for video/audio.",
  "publisher": "viewit",
  "minAppVersion": 1,
  "runtime": "webview-js",
  "jsEntry": "index.js",
  "abiVersion": 1,
  "providers": [
    {
      "id": "player-base.play",
      "packageId": "player-base",
      "service": "viewit.media.play",
      "contractVersion": 1,
      "runtime": "webview-js",
      "trustClass": "trusted-in-process",
      "formats": [
        "mp4",
        "webm",
        "mkv",
        "mov",
        "avi",
        "m4v",
        "3gp",
        "mpg",
        "mpeg",
        "wmv",
        "mp3",
        "m4a",
        "aac",
        "flac",
        "ogg",
        "wav",
        "opus"
      ]
    }
  ]
}
