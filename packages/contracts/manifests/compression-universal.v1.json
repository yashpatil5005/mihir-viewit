{
  "schemaVersion": 1,
  "id": "compression-universal",
  "name": "Compression Universal",
  "version": "0.1.0",
  "description": "Precise listings of every compression format (zip, 7z, rar, tar, gz, bz2, xz, zst, lz4, lzma, tar.*) without extracting first, plus entry previews and extraction to app storage or a folder you choose.",
  "publisher": "viewit",
  "minAppVersion": 1,
  "runtime": "android-dex-jni",
  "entryClass": "ai.viewit.plugins.compressionuniversal.CompressionUniversalPlugin",
  "abi": "arm64-v8a",
  "abiVersion": 1,
  "providers": [
    {
      "id": "compression-universal.list",
      "packageId": "compression-universal",
      "service": "viewit.archive.list",
      "contractVersion": 1,
      "runtime": "android-dex-jni",
      "trustClass": "trusted-in-process",
      "formats": [
        "zip",
        "7z",
        "rar",
        "tar",
        "gz",
        "tgz",
        "bz2",
        "tbz2",
        "xz",
        "txz",
        "zst",
        "tzst",
        "lz4",
        "lzma",
        "tlz",
        "tar.gz",
        "tar.bz2",
        "tar.xz",
        "tar.zst",
        "tar.lz4",
        "tar.lzma"
      ]
    },
    {
      "id": "compression-universal.read-entry",
      "packageId": "compression-universal",
      "service": "viewit.archive.read-entry",
      "contractVersion": 1,
      "runtime": "android-dex-jni",
      "trustClass": "trusted-in-process",
      "formats": [
        "zip",
        "7z",
        "rar",
        "tar",
        "gz",
        "tgz",
        "bz2",
        "tbz2",
        "xz",
        "txz",
        "zst",
        "tzst",
        "lz4",
        "lzma",
        "tlz",
        "tar.gz",
        "tar.bz2",
        "tar.xz",
        "tar.zst",
        "tar.lz4",
        "tar.lzma"
      ]
    },
    {
      "id": "compression-universal.extract",
      "packageId": "compression-universal",
      "service": "viewit.archive.extract",
      "contractVersion": 1,
      "runtime": "android-dex-jni",
      "trustClass": "trusted-in-process",
      "formats": [
        "zip",
        "7z",
        "rar",
        "tar",
        "gz",
        "tgz",
        "bz2",
        "tbz2",
        "xz",
        "txz",
        "zst",
