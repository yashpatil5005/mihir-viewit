# Copy this file to `.env` and fill in values. `.env` is git-ignored.
# Only values that are optional at dev time belong here; everthing else lives
# in app config / workflows with explicit secrets.

# --- Android release (scripts/android-release.sh) ---
# Leave ANDROID_HOME/ANDROID_NDK_HOME set by your SDK launcher if you prefer.
ANDROID_HOME=$HOME/Android/Sdk
ANDROID_NDK_HOME=$HOME/Android/Sdk/ndk/27.2.12479018

# --- Catalog signing (scripts/sign-catalog.py) ---
# Never commit the private key. Public key is distributed to clients.
VIEWIT_CATALOG_PRIV=scripts/.catalog-signing-key.priv
VIEWIT_CATALOG_PUB=scripts/.catalog-signing-key.pub

# --- CI / release builds ---
# Set to a signing keystore path for a published Android release (git-ignored).
VIEWIT_KEYSTORE=
VIEWIT_KEYSTORE_PASS=
