# / — workspace-level ignore
.agent/
*~

# --- OS / editor cruft ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- IDE / tooling ---
.idea/
.vscode/
*.iml
*.swp
*.swo
.zed*

# --- Logs / tmp ---
*.log
*.tmp
tmp/
.cache/

# --- Python ---
**/__pycache__/
*.pyc
*.pyo

# --- Node / SvelteKit ---
node_modules/
dist/
build/
.svelte-kit/
package-lock.json.bak
.vite/
.stats/

# --- Rust / Cargo ---
target/
target_*/
**/*.rs.bk
Cargo.lock.bak

# --- Tauri ---
# NB: `**/` prefix is required — a bare `src-tauri/gen/` is anchored to the repo
# root and would NOT match apps/*/src-tauri/gen/, letting generated Android
# project mirrors (MainActivity.kt, PluginManager.kt, …) get committed.
**/src-tauri/gen/
**/src-tauri/target/
apps/mobile/src-tauri/gen/android/app/src/main/assets/
apps/mobile/src-tauri/gen/android/app/src/main/jniLibs/
apps/mobile/src-tauri/gen/android/app/src/*/jniLibs/
apps/mobile/src-tauri/gen/android/apps/
*.apk
*.aab
*.ipa
*.app

# --- Android ---
.gradle/
local.properties
*.keystore
*.jks
!debug.keystore     # checked-in debug signing only if we choose to later
captures/
.cxx/

# --- iOS ---
Pods/
xcuserdata/
*.xcworkspace/contents.xcworkspacedata

# --- WASM build outputs (mid-stage) ---
*.wasm.tmp

# --- Android plugin derived build output ---
apps/mobile/plugins/*/build/
# Copied plugin .so that tauri gen stages into the Android project (build artifacts)
apps/mobile/src-tauri/android/jniLibs/
apps/mobile/src-tauri/src/main/rust/target/
# runtime=js plugin web bundles are esbuild artifacts regenerated by
# scripts/build-*pptx-vanilla-plugin*.mjs (only plugin.json + LICENSE are kept in-repo)
apps/mobile/plugins/*/web/

# --- Per-project environment ---
.env
.env.*
!.env.example

# --- Catalog signing keys ---
scripts/.catalog-signing-key.priv
scripts/.catalog-signing-key.pub

# --- Playwright E2E ---
test-results/
playwright-report/
playwright/.cache/

# --- Misc project artifacts ---
*.pid
*.seed
*.pids
patches/pdfium-render/
apps/mobile/gen/
plugins/*/build/
plugins/*.zip
