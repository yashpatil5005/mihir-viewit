{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ViewIt",
  "version": "0.1.0-scaffold",
  "identifier": "ai.viewit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ViewIt",
        "width": 1024,
        "height": 768,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data:; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob: data:; frame-src 'self' asset: http://asset.localhost blob: data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["txt"], "mimeType": "text/plain", "role": "Viewer", "rank": "Default" },
      { "ext": ["md"], "mimeType": "text/markdown", "role": "Viewer" },
      { "ext": ["json"], "mimeType": "application/json", "role": "Viewer" },
      { "ext": ["csv"], "mimeType": "text/csv", "role": "Viewer" }
    ]
  },
  "plugins": {}
}
