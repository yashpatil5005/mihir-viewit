{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ViewIt mobile — open files (content:// + file://), shell hand-off, notifications",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-read",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "shell:allow-open",
    "dialog:default",
    "dialog:allow-open",
    "notification:default"
  ]
}